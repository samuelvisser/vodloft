# Settings for the VODLoft service. After changing this file, run: sudo systemctl restart vodloft
# Everything else is set in VODLoft's own Settings screen, which keeps it in /var/lib/vodloft/config.yml.

# The address and port VODLoft listens on.
#VODLOFT_HOST=0.0.0.0
#VODLOFT_PORT=5274

# Require a login (leave unset for open access):
#VL_ADMIN_AUTH__PASSWORD=change-me

# The time zone VODLoft uses, instead of the one chosen in Settings:
#TZ=Europe/Amsterdam
