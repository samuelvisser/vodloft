[
  {"name": "contains a word", "preset": "contains", "ignoreCase": true,
   "blocks": [{"kind": "text", "text": "highlights", "wholeWords": true}],
   "regex": "\\bhighlights\\b",
   "matches": ["Highlights: The future of fusion energy", "Weekly highlights #38"],
   "misses": ["#highlightsreel: our best shots of 2026", "The future of fusion energy"]},
  {"name": "contains text with symbols", "preset": "contains", "ignoreCase": false,
   "blocks": [{"kind": "text", "text": "(Live) 1.5?", "wholeWords": false}],
   "regex": "\\(Live\\) 1\\.5\\?",
   "matches": ["Show (Live) 1.5? yes"], "misses": ["Show (live) 1.5? yes", "Show (Live) 145 yes"]},
  {"name": "starts with", "preset": "contains", "ignoreCase": true,
   "blocks": [{"kind": "position", "at": "start"}, {"kind": "text", "text": "Ep.", "wholeWords": true}],
   "regex": "^\\bEp\\.",
   "matches": ["Ep. 412 - The future", "ep.411 Why bridges sway"], "misses": ["Highlights: Ep. 410 recap", "Episode 87"]},
  {"name": "the whole title", "preset": "contains", "ignoreCase": false,
   "blocks": [{"kind": "position", "at": "start"}, {"kind": "text", "text": "Trailer", "wholeWords": false}, {"kind": "position", "at": "end"}],
   "regex": "^Trailer$",
   "matches": ["Trailer"], "misses": ["Official Trailer", "Trailers"]},
  {"name": "any of these", "preset": "anyOf", "ignoreCase": true,
   "blocks": [{"kind": "oneOf", "items": ["trailer", "teaser", "livestream replay"], "wholeWords": true}],
   "regex": "\\b(?:trailer|teaser|livestream replay)\\b",
   "matches": ["Official Trailer: Season 4", "Livestream replay - Q&A", "A 60 second teaser for next week"],
   "misses": ["Trailers of the week", "Livestream"]},
  {"name": "any of these at the end", "preset": "anyOf", "ignoreCase": false,
   "blocks": [{"kind": "oneOf", "items": ["(Part 1)", "(Part 2)"], "wholeWords": false}, {"kind": "position", "at": "end"}],
   "regex": "(?:\\(Part 1\\)|\\(Part 2\\))$",
   "matches": ["The story (Part 2)"], "misses": ["The story (Part 2) recap", "The story (part 1)"]},
  {"name": "episode number pattern", "preset": "pattern", "ignoreCase": true,
   "blocks": [
     {"kind": "position", "at": "start"}, {"kind": "text", "text": "Ep.", "wholeWords": false},
     {"kind": "spaces", "mode": "optional"}, {"kind": "number", "min": 1, "max": 4, "optional": false},
     {"kind": "spaces", "mode": "optional"}, {"kind": "oneOf", "items": ["-", "–", "|", ":"], "wholeWords": false}],
   "regex": "^Ep\\.\\s*\\d{1,4}\\s*(?:-|–|\\||:)",
   "matches": ["Ep. 412 – The future of fusion energy", "EP.411| Why bridges sway"],
   "misses": ["Highlights: Ep. 410 recap", "Episode 87 - Interview"]},
  {"name": "date and optional group", "preset": "pattern", "ignoreCase": false,
   "blocks": [
     {"kind": "date", "format": "iso"}, {"kind": "optional", "blocks": [{"kind": "text", "text": " (rerun)", "wholeWords": false}]},
     {"kind": "anyText", "max": 10}, {"kind": "number", "min": 2, "max": null, "optional": true}],
   "regex": "\\d{4}-\\d{2}-\\d{2}(?: \\(rerun\\))?.{0,10}(?:\\d{2,})?",
   "matches": ["News 2026-10-28 (rerun)", "2026-01-02"], "misses": ["News 28-10-2026"]},
  {"name": "optional one of", "preset": "pattern", "ignoreCase": false,
   "blocks": [{"kind": "optional", "blocks": [{"kind": "oneOf", "items": ["Ep", "Episode"], "wholeWords": false}]},
     {"kind": "spaces", "mode": "one"}, {"kind": "number", "min": 1, "max": 1, "optional": true}],
   "regex": "(?:Ep|Episode)?\\s\\d?",
   "matches": ["Episode 8", "a b"], "misses": ["nospace"]},
  {"name": "look-ahead stays custom", "preset": "custom", "ignoreCase": true,
   "regex": "^(?!.*\\b(?:trailer|teaser)\\b).*\\b(?:Ep|Episode)\\.?\\s*\\d+",
   "matches": ["Ep. 412 - The future of fusion energy", "Episode 87 - Interview with a bridge engineer"],
   "misses": ["Ep. 409 trailer: the bridge special"]},
  {"name": "a quantified letter stays custom", "preset": "custom", "ignoreCase": false,
   "regex": "colou?r", "matches": ["color", "colour"], "misses": ["colr"]}
]
