{
  "manifest_version": 3,
  "name": "VODLoft",
  "short_name": "VODLoft",
  "version": "1.0.0",
  "description": "Send the cookies of a site you are signed in to straight to your own VODLoft, so it can download what your account can see.",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "Send cookies to VODLoft",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png"
    }
  },
  "permissions": ["cookies", "storage", "activeTab"],
  "optional_host_permissions": ["<all_urls>"],
  "browser_specific_settings": {
    "gecko": {
      "id": "browser-extension@vodloft",
      "strict_min_version": "128.0"
    }
  }
}
